# Run artifacts. Regenerable, and large enough that committing them would make the
# repository unusable to clone. `results/*` rather than `results/` is deliberate: git
# cannot re-include a file whose parent directory is excluded, so a bare `results/`
# plus `!results/*.md` silently fails.
results/*
!results/*.md
runs/
llm-outputs/
data/grid_cells/
data/parity_cells/
data/*.pt
data/*_results*.json
*.log

# Model weights. Fetched, never committed.
models/
*.gguf
*.safetensors

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
src/orion.egg-info/

# Secrets. API keys never enter git.
.env
.env.*
*.key
*_secret*

# Editor and OS
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
