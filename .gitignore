# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test and coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Experiment output.
#
# These are large, machine-generated, and regenerated by running the code. They
# are deliberately NOT versioned: a `git add -A` that sweeps a few hundred banked
# cells into a source commit is how a code change becomes unreviewable.
# Mirror results off the machine that produced them instead.
# Generated cells and checkpoints are ignored, but data/ is NOT wholly generated:
# it also holds fixtures the code and tests require. Ignoring it wholesale is how
# a fresh clone ends up unable to run its own test suite.
data/*
!data/kb_entries.json
!data/memory/
!data/placement_eval/
!data/slice_intents/

results/
runs/
logs/
*.log
*.pt
*.gguf

# Local scratch.
#
# Scratch belongs outside the tree. The provenance guard refuses untracked files
# under scripts/ and src/, but it does not watch the repository root, which is
# where 34 loose probe scripts accumulated before the 2026-08-22 cleanup.
scratch/
tmp/
*.tmp

# Secrets. Never tracked, and named here so a future `git add -A` cannot change
# that by accident: .env.frontier holds a frontier-model API key.
.env
.env.*
*.key
*.pem

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
